# Server
PORT=3000
NODE_ENV=development

# Redis (BullMQ backend)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue settings
REDIS_CONCURRENCY=5
JOB_DEFAULT_PRIORITY=1000
JOB_ATTEMPTS=3
JOB_BACKOFF_TYPE=exponential
JOB_BACKOFF_DELAY=1000

# JWT (for API auth)
JWT_SECRET=dev_jwt_secret_change_in_production

# Queue names
QUEUE_MAIL=mail
QUEUE_ANALYTICS=analytics
QUEUE_NOTIFICATIONS=notifications
QUEUE_EXPORT=export
